{:paths ["src" "resources"]
 :deps {org.clojure/clojure         {:mvn/version "1.12.2"}
        babashka/fs                 {:mvn/version "0.5.27"}
        com.sturdystats/sturdy-fs   {:mvn/version "0.1.5"}
        com.taoensso/tempel         {:mvn/version "1.1.0"}
        com.taoensso/truss          {:mvn/version "2.2.0"}
        ;;
        com.taoensso/telemere       {:mvn/version "1.2.1"}}

 :aliases {:test
           {:extra-paths ["test" "test-resources"]
            :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                          ring/ring-mock {:mvn/version "0.6.1"}}
            :main-opts ["-m" "cognitect.test-runner"]
            :exec-fn     cognitect.test-runner.api/test}

           :generate-longterm
           {:exec-fn bailey.keys.longterm/generate-longterm!
            :exec-args {:secrets-dir   "secrets"
                        :resources-dir "resources"
                        :password      nil}}

           :build
           {:deps {io.github.clojure/tools.build {:mvn/version "0.10.10"}
                   slipset/deps-deploy           {:mvn/version "0.2.2"}}
            :ns-default build}

           :deploy
           {:deps {io.github.clojure/tools.build {:mvn/version "0.10.10"}
                   slipset/deps-deploy           {:mvn/version "0.2.2"}}
            :ns-default build}}}

